#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Validate commit message format
commit_msg=$(cat "$1")

# Check if commit message follows conventional commits format
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\(.+\))?: .{1,}"; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Commit message should follow conventional commits format:"
  echo "  type(scope?): subject"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build"
  echo ""
  echo "Examples:"
  echo "  feat: add user authentication"
  echo "  fix(voting): correct apartment calculation"
  echo "  docs: update README with setup instructions"
  exit 1
fi

echo "✅ Commit message is valid"

